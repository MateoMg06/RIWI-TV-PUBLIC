{
  "name": "app",
  "version": "1.0.0",
  "description": "API con Node, Express, TypeScript, Swagger, Jest y Sequelize para PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run migrate",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "prestart": "npm run migrate",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check eslint.config.mjs .prettierrc.json package.json tsconfig.json src/index.ts src/server.ts src/__tests__ src/migrations src/config/environment.ts src/config/cors.ts src/config/database.cli.js src/controllers/health.controller.ts src/dto/health-check.dto.ts src/middlewares/requestLogger.ts src/repositories/health.repository.ts src/repositories/interfaces/health.repository.interface.ts src/routes/health.routes.ts src/routes/v1.routes.ts src/services/health.service.ts src/services/interfaces/health.service.interface.ts src/utils/logger.ts",
    "migrate": "sequelize-cli db:migrate",
    "migrate:status": "sequelize-cli db:migrate:status",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "ts-node-dev --transpile-only src/seeders/seed.ts"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "sequelize": "^6.37.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "sequelize-cli": "^6.6.5",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
