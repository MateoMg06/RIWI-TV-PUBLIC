{
  "info": {
    "_postman_id": "5c2cb899-2730-43ca-902a-4b8ff0fb641d",
    "name": "RIWI-TV API - develop",
    "description": "Colección sincronizada con las rutas reales de la rama develop. Importe también RIWI-TV.postman_environment.example.json y seleccione el entorno. El login guarda accessToken como cookie HTTP y copia access_token y refresh_token al entorno. Para probar el flujo completo, ejecute primero las solicitudes de creación en orden: usuario, país, departamento, ciudad, película y cine.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Sistema",
      "item": [
        {
          "name": "Comprobar servidor",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/test",
            "description": "Comprueba que Express está respondiendo. No consulta la base de datos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Servidor funcionando', () => pm.expect(pm.response.json().message).to.eql('Servidor funcionando correctamente!'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Health check v1",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/health",
            "description": "Comprueba la disponibilidad de la API y el estado de la conexión con PostgreSQL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Incluye estado de API y base de datos', () => { const data = pm.response.json(); pm.expect(data).to.have.property('status'); pm.expect(data).to.have.property('database'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Abrir Swagger",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "text/html" }
