    {
      "name": "Usuarios y autenticación",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{user_name}}\",\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/users",
            "description": "Crea un usuario. role es opcional y el backend usa usuario por defecto. Guarda el id retornado en user_id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const data = pm.response.json(); if (data.id) pm.environment.set('user_id', data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Respuesta tipo lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Validar credenciales",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/users/auth",
            "description": "Valida email y contraseña. Devuelve 200; no genera tokens ni cookies."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión JWT",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/users/login",
            "description": "Genera accessToken y refreshToken. Postman conserva automáticamente la cookie accessToken requerida por Actualizar usuario."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const data = pm.response.json(); pm.environment.set('access_token', data.accessToken || ''); pm.environment.set('refresh_token', data.refreshToken || ''); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Refrescar access token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/users/refresh",
            "description": "Genera un nuevo access token y reemplaza la cookie accessToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const data = pm.response.json(); pm.environment.set('access_token', data.newToken || ''); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Cookie", "value": "accessToken={{access_token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Postman Actualizado\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/users/{{user_id}}",
            "description": "Requiere la cookie accessToken creada por Login. El código actual acepta name, email y password."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/users/logout",
            "description": "Elimina la cookie accessToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
