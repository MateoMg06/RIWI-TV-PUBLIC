{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node", "jest"]
  },
  "include": ["src", "src/types", "src/middlewares", "src/models/RIWI-T"],
  "exclude": ["node_modules", "dist"]
}
